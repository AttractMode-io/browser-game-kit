{
  "name": "@attractmode/browser-game-kit",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A runnable browser game with a server-side Attract Mode account integration",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start:connected": "node --env-file=.env server.mjs --connected",
    "test": "node --test tests/*.test.mjs",
    "test:agents": "node --test agents/install.test.mjs"
  },
  "dependencies": {
    "openid-client": "6.8.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AttractMode-io/browser-game-kit.git"
  },
  "homepage": "https://attractmode.io/docs",
  "bugs": {
    "url": "https://github.com/AttractMode-io/browser-game-kit/issues"
  },
  "keywords": [
    "browser-game",
    "openid-connect",
    "pkce",
    "threejs",
    "agent-skills",
    "mcp",
    "attract-mode"
  ]
}
