# Real registration is required. Never paste these values into browser code.
AM_GAME_CLIENT_ID=
AM_GAME_CLIENT_SECRET=
# Must be the exact operator-registered HTTPS callback:
AM_GAME_REDIRECT_URI=https://your-game.example/auth/callback
# This sample always listens on loopback. Use a trusted HTTPS reverse proxy.
PORT=3000

# Persistent server-only random key, independent from OAuth secret rotation.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AM_PLAYER_ID_KEY=
AM_ENVIRONMENT=production

# Game ID supplied with your approved integration registry entry:
AM_GAME_ID=

# Production only: private persistent single-host storage (see production-storage.md).
# AM_SESSION_DB=/absolute/private/state/sessions.db
# AM_SESSION_KEY=<separate random 64-character hex key>

# Optional progression: enable only after this game's integration is approved and
# a separate player-scoped credential has been issued for this environment.
# Leave disabled for the offline demo. Never use event/definition credentials here.
AM_PROGRESSION_ENABLED=false
AM_PROGRESSION_ENDPOINT=
AM_PROGRESSION_CREDENTIAL=
# Obtain the approved HTTPS endpoint privately during setup; do not guess one.
# Event and definition credentials belong in separate validator/admin secret stores,
# not this browser bridge, source control, browser bundles, or diagnostic output.
