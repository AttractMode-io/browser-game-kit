{
  "schemaVersion": 1,
  "purpose": "Prepare a private reviewed request, not an API call or automatic publication.",
  "workspace": "https://attractmode.io/developers",
  "emailFallback": "hello@attractmode.io",
  "privacy": "Never include secrets, passwords, payment details or player data. public_contact is optional and intended for publication; account email is not public contact.",
  "instructions": "Complete only the relevant kind. Save incomplete work as a draft. For email, send the completed kind with a subject naming your game. Unknown facts should remain unknown with notes. No anonymous write API or MCP submission tool exists.",
  "requests": {
    "listing": {
      "fields": {
        "game_name": "",
        "studio_name": "",
        "game_url": "",
        "description": "",
        "genres": "",
        "devices": "",
        "controls": "",
        "access_requirements": "",
        "official_url": "",
        "media_urls": "",
        "media_credit": "",
        "media_permission": "",
        "public_contact": "",
        "notes": ""
      },
      "definitions": [
        {
          "name": "game_name",
          "label": "Game name",
          "type": "text",
          "maxLength": 120,
          "required": true
        },
        {
          "name": "studio_name",
          "label": "Developer or studio",
          "type": "text",
          "maxLength": 120,
          "required": true
        },
        {
          "name": "game_url",
          "label": "Playable game URL",
          "type": "url",
          "maxLength": 1000,
          "required": true
        },
        {
          "name": "description",
          "label": "What players do and what makes it interesting",
          "type": "textarea",
          "maxLength": 4000,
          "required": true
        },
        {
          "name": "genres",
          "label": "Genres and specific mechanics",
          "type": "text",
          "maxLength": 500,
          "required": true
        },
        {
          "name": "devices",
          "label": "Supported devices and browsers",
