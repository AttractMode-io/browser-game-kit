          "type": "textarea",
          "maxLength": 2000,
          "required": true
        },
        {
          "name": "access_requirements",
          "label": "Account, price and access requirements",
          "type": "textarea",
          "maxLength": 2000,
          "required": true
        },
        {
          "name": "official_url",
          "label": "Official developer website or profile",
          "type": "url",
          "maxLength": 1000,
          "required": true
        },
        {
          "name": "media_urls",
          "label": "Screenshot or press-kit URLs, one per line",
          "type": "urls",
          "maxLength": 5000,
          "required": true
        },
        {
          "name": "media_credit",
          "label": "Image credit and source",
          "type": "textarea",
          "maxLength": 2000,
          "required": true
        },
        {
          "name": "media_permission",
          "label": "Permission to use the submitted images",
          "type": "select",
          "maxLength": 40,
          "required": true,
          "options": [
            "owned",
            "permission_granted",
            "press_kit"
          ]
        },
        {
          "name": "public_contact",
          "label": "Optional public business contact",
          "type": "text",
          "maxLength": 200,
          "required": false
        },
        {
          "name": "notes",
          "label": "Anything else we should know",
          "type": "textarea",
          "maxLength": 2000,
          "required": false
        }
      ]
    },
